<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

<changeSet id="2025-02-06-01-quest-info-entity" author="stepanov">
    <createTable tableName="quest_info_entity" >
        <column autoIncrement="true" name="id" type="BIGINT">
            <constraints nullable="false" primaryKey="true" primaryKeyName="quest_info_entity_pkey"/>
        </column>
        <column name="button_left_text" type="VARCHAR(256)"/>
        <column name="button_right_text" type="VARCHAR(256)"/>
        <column name="result_left_text" type="VARCHAR(256)"/>
        <column name="result_right_text" type="VARCHAR(256)"/>
        <column name="delta_time" type="jsonb"/>
        <column name="delta_evidence" type="jsonb"/>
        <column name="delta_gold" type="jsonb"/>
        <column name="description" type="VARCHAR(1024)"/>
        <column name="imageUrl" type="VARCHAR(64)"/>
    </createTable>
</changeSet>
</databaseChangeLog>